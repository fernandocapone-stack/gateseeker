{
  "name": "gateseeker",
  "version": "1.0.0-beta.3",
  "description": "Security gate for AI-generated code. Sprint 0: npm lockfile analysis against OSV with deterministic prioritization.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0",
  "bin": {
    "gateseeker": "dist/cli.js",
    "gateseeker-intel": "dist/intel-cli.js",
    "gateseeker-action": "dist/action-cli.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "advisories/LICENSE",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node dist/intel-cli.js build && pnpm --filter @gateseeker/ui build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandocapone-stack/gateseeker.git"
  },
  "homepage": "https://github.com/fernandocapone-stack/gateseeker#readme",
  "keywords": [
    "security",
    "supply-chain",
    "sca",
    "osv",
    "composer",
    "npm",
    "github-action",
    "vibe-coding"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
